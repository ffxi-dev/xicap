{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled"
  ],
  "timezone": "America/Denver",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Python packages pinned with == in workflow steps",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\s(?<depName>[A-Za-z][\\w.-]*)==(?<currentValue>\\d[\\w.]*)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "FetchContent downloads from GitHub; a bump also needs a new URL_HASH",
      "managerFilePatterns": [
        "/(^|/)CMakeLists\\.txt$/"
      ],
      "matchStrings": [
        "URL https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/(?:archive/refs/tags|releases/download)/v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "The emsdk version CI builds the Wasm binding with",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "setup-emsdk@\\S+\\s+with:\\s+version:\\s+\"(?<currentValue>[\\d.]+)\""
      ],
      "depNameTemplate": "emscripten-core/emsdk",
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "description": "One pull request for every minor and patch update",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "minor and patch updates"
    }
  ]
}
