{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "outDir": "./dist",
        "rootDir": "./src",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowJs": false,
        "isolatedModules": true,
        "lib": ["ES2022", "DOM"]
    },
    "include": ["src/**/*"],
    "exclude": ["dist", "node_modules", "test"]
}
