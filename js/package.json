{
    "name": "@xicap/wasm",
    "version": "3.5.0",
    "description": "WebAssembly reader for xicap FFXI packet captures.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./xicap.wasm": "./dist/xicap.wasm"
    },
    "files": [
        "dist/index.js",
        "dist/index.d.ts",
        "dist/xicap.js",
        "dist/xicap.wasm"
    ],
    "scripts": {
        "build:wasm": "node ./scripts/build-wasm.mjs",
        "build:ts": "tsc",
        "build": "npm run build:wasm && npm run build:ts",
        "test": "node --test test/reader.test.mjs"
    },
    "engines": {
        "node": ">=18"
    },
    "license": "MIT"
}
